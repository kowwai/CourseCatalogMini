@model List<CourseCatalogMini.Data.Entities.Course>

@{
    ViewData["Title"] = "Каталог на курсове";
}

<h1>Каталог на курсове</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави курс
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Име</th>
            <th>Преподавател</th>
            <th>Категория</th>
            <th>Часове</th>
            <th>Описание</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Name</td>
                <td>@course.Teacher</td>
                <td>@course.Category</td>
                <td>@course.DurationHours</td>
                <td>@course.Description</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p>Все още няма добавени курсове.</p>
}