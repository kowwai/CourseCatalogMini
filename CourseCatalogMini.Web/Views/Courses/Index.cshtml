@model CoursesIndexViewModel

@{
    ViewData["Title"] = "Каталог на курсове";
}

<h1>Каталог на курсове</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави курс
    </a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Търси по име..." />
        </div>

        <div class="col-md-4">
            <select name="category" class="form-select">
                <option value="">Всички категории</option>

                @foreach (var category in new[]
                                {
                                "Програмиране",
                                "Езици",
                                "Дизайн",
                                "Бизнес",
                                "Други"
                                })
                {
                    if (Model.Category == category)
                    {
                        <option value="@category" selected>
                            @category
                        </option>
                    }
                    else
                    {
                        <option value="@category">
                            @category
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit"
                    class="btn btn-success">
                Търси
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Изчисти
            </a>
        </div>
    </div>
</form>

@if (Model.Courses.Count == 0)
{
    <p>Няма намерени курсове.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Име</th>
                <th>Преподавател</th>
                <th>Категория</th>
                <th>Часове</th>
                <th>Описание</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td>@course.Id</td>
                    <td>@course.Name</td>
                    <td>@course.Teacher</td>
                    <td>@course.Category</td>
                    <td>@course.DurationHours</td>
                    <td>@course.Description</td>
                </tr>
            }
        </tbody>
    </table>
}
